# Clés API LLM
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...
GOOGLE_API_KEY=...
PERPLEXITY_API_KEY=...

# Prix des modèles (en $/1K tokens)
GPT4O_PRICE_INPUT=0.0025
GPT4O_PRICE_OUTPUT=0.010
CLAUDE_SONNET_PRICE_INPUT=0.003
CLAUDE_SONNET_PRICE_OUTPUT=0.015
MISTRAL_LARGE_PRICE_INPUT=0.002
MISTRAL_LARGE_PRICE_OUTPUT=0.006
GEMINI_PRO_PRICE_INPUT=0.00125
GEMINI_PRO_PRICE_OUTPUT=0.005

# Taux de conversion
USD_EUR_RATE=0.92

# Google OAuth (créer sur console.cloud.google.com)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Firebase Admin SDK (générer depuis Firebase Console → Paramètres du projet → Comptes de service)
FIREBASE_PROJECT_ID=...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@....iam.gserviceaccount.com

# Serveur
PORT=3001
